{
  "name": "sinan",
  "version": "0.1.0",
  "description": "司南 —— 本地刷题训练台：多标签解法打标 + 按真实题解思路递进的学习计划（LeetCode / CodeTop / 洛谷）",
  "type": "module",
  "bin": {
    "sinan": "bin/sinan.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "web",
    "scripts",
    "README.md",
    "LICENSE",
    "!dist/test",
    "!scripts/__pycache__"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "leetcode",
    "codetop",
    "luogu",
    "algorithm",
    "study-plan",
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
