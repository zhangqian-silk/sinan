{
  "name": "sinan",
  "version": "0.1.0",
  "description": "司南 —— 本地刷题训练台：多标签解法打标 + 按真实题解思路递进的学习计划（LeetCode / CodeTop / 洛谷）",
  "author": "SILK",
  "license": "MIT",
  "homepage": "https://github.com/zhangqian-silk/sinan#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangqian-silk/sinan.git"
  },
  "bugs": {
    "url": "https://github.com/zhangqian-silk/sinan/issues"
  },
  "type": "module",
  "bin": {
    "sinan": "bin/sinan.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "web",
    "baseline",
    "README.md",
    "LICENSE",
    "!dist/test"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check:links": "npm run build && node dist/tools/check-links.js",
    "fixture": "npm run build && node dist/tools/make-fixture.js",
    "baseline": "npm run build && node dist/tools/pack.js \"$SINAN_DIST\" baseline",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "leetcode",
    "codetop",
    "luogu",
    "algorithm",
    "study-plan",
    "cli"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.39.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0"
  }
}
